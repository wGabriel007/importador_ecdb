// Copie este arquivo para "appsettings.json" (na mesma pasta) e preencha com os dados reais.
// O appsettings.json NÃO deve ir para o Git (está no .gitignore) porque contém senha.
{
  "ConnectionStrings": {
    "BancoOrigem": "Server=SEU_SERVIDOR;Port=3306;Database=ecdb;User=SEU_USUARIO;Password=SUA_SENHA;Connection Timeout=30;DefaultCommandTimeout=600;",
    "BancoDestino": "Server=SEU_SERVIDOR;Port=3306;Database=new_ecdb;User=SEU_USUARIO;Password=SUA_SENHA;Connection Timeout=30;DefaultCommandTimeout=300;"
  },
  // Opcional: evita a detecção automática da versão do MySQL na inicialização
  "MySql": {
    "ServerVersion": "8.0.32"
  }
}
